# Database
POSTGRES_USER=startup_radar
POSTGRES_PASSWORD=startup_radar
POSTGRES_DB=startup_radar
DATABASE_URL=postgresql+asyncpg://startup_radar:startup_radar@postgres:5432/startup_radar
DATABASE_URL_SYNC=postgresql://startup_radar:startup_radar@postgres:5432/startup_radar

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Optional enrichment
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional source credentials
# Product Hunt: put API Key + API Secret from the OAuth app page.
# Redirect URI is not used. PRODUCT_HUNT_TOKEN is only needed if you already
# have a Bearer access token / developer token.
PRODUCT_HUNT_API_KEY=
PRODUCT_HUNT_API_SECRET=
PRODUCT_HUNT_TOKEN=
DEALROOM_API_KEY=

# Scraping
USER_AGENT=StartupRadarBot/1.0 (+https://github.com/startup-radar)
SCRAPER_CONCURRENCY=2
SCRAPER_REQUEST_DELAY_SECONDS=2
YC_MAX_COMPANIES=25

# Web
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=Startup Radar
WEB_PORT=3000
API_PORT=8000
